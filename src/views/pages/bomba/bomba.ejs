<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
    <link rel="stylesheet" href="../../../css/main.css">
</head>
<body>
    <main class="contenido-principal contenido-bomba">
        <div class="indicador-vidas" id="indicador-vidas">Vidas: <span id="contador-vidas">3</span></div>
            <div class="contenido">
                <div class="ventana-preguntas">
                    <!--  -->
                    <div id="ventana-bomba">
                    <!-- Aquí pondría las vidas como tres corazoncitos -->
                        <div id="pantalla-pregunta">
                            <h2 id="texto-pregunta">Cargando pregunta...</h2>
                            <div id="contenedor-cables"></div>
                        </div>
                    </div>
                </div>
                <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
                <model-viewer 
                    src="/models/bomba_4.glb" 
                    class="bomba-3d"
                    id="bomba-3d"
                    camera-controls 
                    shadow-intensity="1"
                    auto-rotate
                </model-viewer>
            </div>
        </div>        
    </main>
    <script src="js/script.js"></script>
</body>
</html>