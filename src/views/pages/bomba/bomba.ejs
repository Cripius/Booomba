<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
    <link rel="stylesheet" href="../../../css/main.css">
</head>
<body>
    <main class="contenido-principal contenido-bomba">
        <div class="indicador-vidas" id="indicador-vidas">Vidas: <span id="contador-vidas">3</span></div>
            <div class="contenido">
                <div class="ventana-preguntas">
                    <!--  -->
                    <div class="ventana-bomba" id="ventana-bomba">
                    <!-- Aquí pondría las vidas como tres corazoncitos -->
                        <div class="pantalla-pregunta" id="pantalla-pregunta">
                            <h2  class="texto-pregunta" id="texto-pregunta">Cargando pregunta...</h2>
                            <div class="contenedor-cables" id="contenedor-cables">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="ventana-derecha">
                    <div id="explosion-animacion"></div>
                    <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
                <model-viewer 
                    src="/models/bomba_5.glb" 
                    class="bomba-3d"
                    id="bomba-3d"
                    camera-controls 
                    shadow-intensity="2"
                    auto-rotate
                    orientation="0 -90deg 180deg">
                </model-viewer>
                </div>
            
            </div>
        </div>        
    </main>
    <script src="js/script.js"></script>
</body>
</html>