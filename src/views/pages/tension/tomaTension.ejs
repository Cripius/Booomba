<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
    <link rel="stylesheet" href="../../../css/main.css">
    <link rel="stylesheet" href="../../../css/tension.css">
    <link rel="stylesheet" href="../../../css/boton.css">
</head>
<body>
    <%- include("../../partials/cabecera.ejs", { titulo: "Toma Tensión" }) %>
    <main class="contenido-principal contenido-toma">
        <div class="formulario-ventana">
            <a href="/">← Volver a Inicio</a>
            <form class="formulario" action="/Tension/tomaTension/<%= id %>" method="POST">

                <% for(let i=1; i<= 3; i++){ %> 
                <div class="formulario-ventana_secciones" 
                    id="seccion_toma_<%= i %>"
                    style="<%= i > 1 ? 'display: none;' : '' %>">
                        <div class="formulario-ventana_seccion">
                            <label for="tension_sys_<%=i%>">Sístole</label>
                            <input type="text" id="tension_sys_<%=i%>" name="tension_sys_<%=i%>">
                        </div>
                        <div class="formulario-ventana_seccion">
                            <label for="tension_dia_<%=i%>">Diástole</label>
                            <input type="text" id="tension_dia_<%=i%>" name="tension_dia_<%=i%>">
                        </div>
                        <div class="formulario-ventana_seccion">
                            <label for="tension_pul_<%=i%>">Pulsaciones</label>
                            <input type="text" id="tension_pul_<%=i%>" name="tension_pul_<%=i%>">
                        </div>
                    </div>
                <%}%>
                <a id="boton-añadir_toma">+ Añadir otra toma</a>
                <button class="rectangular-button" type="submit">Validar</button>
            </form>
            <a href="/Tension/tomaTension/validacion/<%= id %>">Ir a validación</a>
            <script>
                let tomaActual = 1;
                document.getElementById('boton-añadir_toma').addEventListener('click', function() {
                //ANTES DE QUE SE OCULTE HAY QUE COMPROBAR QUE HAY DATOS
                    const sys = document.getElementById(`tension_sys_${tomaActual}`).value;
                    const dia = document.getElementById(`tension_dia_${tomaActual}`).value;
                    const pul = document.getElementById(`tension_pul_${tomaActual}`).value;
                if (!sys || !dia || !pul) {
                    alert("Rellena los datos de la toma actual antes de añadir una nueva.");
                    return;
                }
                const filaAntigua = document.getElementById(`seccion_toma_${tomaActual}`)
                filaAntigua.classList.add("seccion_oculta");
                tomaActual++;
                if (tomaActual <= 3) {
                    const siguienteFila = document.getElementById(`seccion_toma_${tomaActual}`);
                    siguienteFila.style.display = "flex"; //hacemos que se
                    // Hacer scroll suave hacia la nueva toma
                    // siguienteFila.scrollIntoView({ behavior: 'smooth' });
                }
                if (tomaActual === 3) {
                        this.style.display = 'none';
                    }
                });
            </script>
        
            
        </div>
    </main>
</body>
</html>