<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Datos registrados</title>
    <link rel="stylesheet" href="../../../css/main.css">
    <link rel="stylesheet" href="../../../css/tension.css">
    </head>
<body>  
    <%- include("../../partials/cabecera.ejs", { titulo: "Datos registrados" }) %>
    <main class="contenido-principal contenido-data">
    <% datos.forEach( function(toma) { %>
        <ul class="lista-tomas">
            <li class="lista-tomas_item"> Identificador: <%= toma.id %> </li>
            <li class="lista-tomas_item"> Fecha de la toma: <%= toma.fecha %></li>
            <li class="lista-tomas_item"> Presión sistólica: <%= toma.presion_sys.value + ' ' + toma.presion_sys.unit %> </li>
            <li class="lista-tomas_item"> Presión sistólica: <%= toma.presion_dia.value + ' ' + toma.presion_dia.unit %> </li>
            <li class="lista-tomas_item"> Presión sistólica: <%= toma.presion_pul.value + ' ' + toma.presion_pul.unit %> </li>
        </ul>
    <% }); %>
    </main>
</body>
</html>
